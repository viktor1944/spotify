<script id="app">
(() => {
  "use strict";

  const $ = s => document.querySelector(s);
  const STORE_KEY = "playlistsSpotify:v1";

  const listEl = $("#playlist-list");
  const navEl = $("#alphabet");
  const countEl = $("#count");
  const emptyEl = $("#empty");
  const search = $("#search");
  const addBtn = $("#add-btn");
  const editBtn = $("#edit-btn");
  const saveBtn = $("#save-btn");
  const editor = $("#editor");
  const form = $("#editor-form");
  const fTitle = $("#editor-title");
  const fLink = $("#f-link");
  const fNome = $("#f-nome");
  const fTag = $("#f-tag");
  const fMsg = $("#f-msg");
  const fOk = $("#f-ok");
  const toastEl = $("#toast");

  const norm = v => String(v).normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
  const esc = v => String(v).replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
  const parseId = t => { const m = String(t || "").match(/playlist[\/:]([A-Za-z0-9]{22})/); return m ? m[1] : null; };
  const valid = p => p && typeof p.nome === "string" && p.nome.trim() && /^[A-Za-z0-9]{22}$/.test(p.id);
  const clean = p => { const o = { nome: p.nome.trim() }; if (p.tag && String(p.tag).trim()) o.tag = String(p.tag).trim(); o.id = p.id; return o; };
  const label = p => p.tag ? `${p.nome} (${p.tag})` : p.nome;

  function cmp(a, b) {
    const x = norm(a.nome), y = norm(b.nome);
    if (x !== y) return x < y ? -1 : 1;
    const p = norm(a.tag || ""), q = norm(b.tag || "");
    return p < q ? -1 : p > q ? 1 : 0;
  }

  function hash(arr) {
    const s = JSON.stringify(arr.map(clean).sort((a, b) => (a.id < b.id ? -1 : 1)));
    let h = 5381;
    for (let i = 0; i < s.length; i++) h = ((h << 5) + h + s.charCodeAt(i)) | 0;
    return (h >>> 0).toString(36);
  }

  function diffCount(a, b) {
    const A = new Map(a.map(p => [p.id, p]));
    const B = new Map(b.map(p => [p.id, p]));
    let n = 0;
    for (const [id, p] of B) {
      const o = A.get(id);
      if (!o || o.nome !== p.nome || (o.tag || "") !== (p.tag || "")) n++;
    }
    for (const id of A.keys()) if (!B.has(id)) n++;
    return n;
  }

  // ---- dados: o que está gravado no arquivo + alterações guardadas neste navegador
  const fileData = JSON.parse($("#dados").textContent).filter(valid).map(clean);
  const baseHash = hash(fileData);
  let reference = fileData.map(p => ({ ...p }));
  let list = fileData.map(p => ({ ...p }));
  let fileHandle = null;
  let editingId = null;

  try {
    const s = JSON.parse(localStorage.getItem(STORE_KEY) || "null");
    if (s && s.base === baseHash && Array.isArray(s.list)) list = s.list.filter(valid).map(clean);
  } catch (e) { /* sem localStorage: segue só com o arquivo */ }

  function persist() {
    try { localStorage.setItem(STORE_KEY, JSON.stringify({ base: baseHash, list })); } catch (e) {}
  }

  // ---- lista
  function letterOf(nome) {
    const c = norm(nome).replace(/[^a-z0-9]/g, "")[0] || "#";
    return /[a-z]/.test(c) ? c.toUpperCase() : "#";
  }

  function render() {
    list.sort(cmp);
    const letters = [];
    const width = Math.max(2, String(list.length).length);

    listEl.innerHTML = list.map((p, i) => {
      const L = letterOf(p.nome);
      let anchor = "";
      if (letters[letters.length - 1] !== L) {
        letters.push(L);
        anchor = ` id="letra-${L === "#" ? "0" : L}"`;
      }
      return `
    <article class="playlist-row" data-id="${p.id}" data-search="${esc(norm(p.nome + " " + (p.tag || "")))}"${anchor}>
      <span class="number">${String(i + 1).padStart(width, "0")}</span>
      <div class="playlist-info">
        <div class="title-line">
          <span class="playlist-name">${esc(p.nome)}</span>
          ${p.tag ? `<span class="badge">${esc(p.tag)}</span>` : ""}
        </div>
      </div>
      <div class="actions">
        <span class="row-tools">
          <button type="button" class="icon-btn" data-act="edit" title="Editar" aria-label="Editar ${esc(label(p))}">✎</button>
          <button type="button" class="icon-btn danger" data-act="del" title="Remover" aria-label="Remover ${esc(label(p))}">✕</button>
        </span>
        <a class="button web" href="https://open.spotify.com/playlist/${p.id}" rel="noopener noreferrer">Abrir no Spotify</a>
        <a class="button app" href="spotify:playlist:${p.id}" title="Abre no aplicativo do Spotify, quando instalado">Abrir no aplicativo</a>
      </div>
    </article>`;
    }).join("");

    navEl.innerHTML = letters.map(L => `<a href="#letra-${L === "#" ? "0" : L}">${L}</a>`).join("");
    countEl.textContent = `${list.length} playlists em ordem alfabética`;
    applyFilter();
    updateSave();
  }

  function applyFilter() {
    const term = norm(search.value.trim());
    let visible = 0;
    for (const row of listEl.children) {
      const match = row.dataset.search.includes(term);
      row.style.display = match ? "" : "none";
      if (match) visible++;
    }
    emptyEl.style.display = visible ? "none" : "block";
  }

  function updateSave() {
    const n = diffCount(reference, list);
    saveBtn.hidden = n === 0;
    saveBtn.innerHTML = `Salvar arquivo<span class="pill">${n}</span>`;
    saveBtn.title = n === 1 ? "1 alteração ainda não gravada no arquivo" : `${n} alterações ainda não gravadas no arquivo`;
  }

  function flash(id) {
    const row = listEl.querySelector(`[data-id="${id}"]`);
    if (!row) return;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    row.scrollIntoView({ block: "center", behavior: reduce ? "auto" : "smooth" });
    row.classList.remove("flash");
    void row.offsetWidth;
    row.classList.add("flash");
    setTimeout(() => row.classList.remove("flash"), 2000);
  }

  let toastTimer;
  function toast(msg, ms = 2600) {
    toastEl.textContent = msg;
    toastEl.classList.add("show");
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toastEl.classList.remove("show"), ms);
  }

  // ---- janela de adicionar / editar
  let fetchCtl = null;
  let autoNome = false;

  function setMsg(text, isError = false) {
    fMsg.textContent = text;
    fMsg.classList.toggle("error", isError);
    fOk.disabled = isError;
  }

  function openEditor(p, link = "") {
    editingId = p ? p.id : null;
    fTitle.textContent = p ? "Editar playlist" : "Adicionar playlist";
    fOk.textContent = p ? "Salvar alterações" : "Adicionar";
    fLink.value = p ? `https://open.spotify.com/playlist/${p.id}` : link;
    fNome.value = p ? p.nome : "";
    fTag.value = p ? (p.tag || "") : "";
    autoNome = !p;
    setMsg("");
    editor.showModal();
    if (p || link) fNome.focus(); else fLink.focus();
    if (!p && link) onLink();
  }

  async function onLink() {
    if (fetchCtl) { fetchCtl.abort(); fetchCtl = null; }
    const raw = fLink.value.trim();
    if (!raw) { setMsg(""); return; }

    const id = parseId(raw);
    if (!id) { setMsg("Esse link não é de uma playlist do Spotify.", true); return; }

    const dup = list.find(p => p.id === id && p.id !== editingId);
    if (dup) { setMsg(`Essa playlist já está na lista como “${label(dup)}”.`, true); return; }

    if (!autoNome && fNome.value.trim()) { setMsg(""); return; }

    setMsg("Buscando o nome da playlist…");
    const ctl = fetchCtl = new AbortController();
    const timer = setTimeout(() => ctl.abort(), 6000);
    try {
      const url = "https://open.spotify.com/oembed?url=" + encodeURIComponent("https://open.spotify.com/playlist/" + id);
      const r = await fetch(url, { signal: ctl.signal });
      if (!r.ok) throw new Error("HTTP " + r.status);
      const j = await r.json();
      if (ctl !== fetchCtl) return;
      const title = String(j.title || "").replace(/^this is\s+/i, "").trim();
      if (title && (autoNome || !fNome.value.trim())) {
        fNome.value = title;
        if (document.activeElement !== fTag) { fNome.focus(); fNome.select(); }
        setMsg("Nome puxado do Spotify. Ajuste se quiser e aperte Enter.");
      } else {
        setMsg("Digite o nome do artista.");
      }
    } catch (e) {
      if (ctl === fetchCtl) {
        setMsg("Não deu pra puxar o nome sozinho. Digite o nome do artista.");
        if (document.activeElement !== fTag) fNome.focus();
      }
    } finally {
      clearTimeout(timer);
    }
  }

  fLink.addEventListener("input", onLink);
  fNome.addEventListener("input", () => { autoNome = false; if (!fMsg.classList.contains("error")) setMsg(""); });
  $("#f-cancel").addEventListener("click", () => editor.close());
  editor.addEventListener("close", () => { if (fetchCtl) { fetchCtl.abort(); fetchCtl = null; } });

  form.addEventListener("submit", e => {
    e.preventDefault();
    const id = parseId(fLink.value);
    const nome = fNome.value.trim();
    if (!id) { setMsg("Cole o link de uma playlist do Spotify.", true); fLink.focus(); return; }
    const dup = list.find(p => p.id === id && p.id !== editingId);
    if (dup) { setMsg(`Essa playlist já está na lista como “${label(dup)}”.`, true); return; }
    if (!nome) { setMsg("Digite o nome do artista."); fNome.focus(); return; }

    const item = clean({ nome, tag: fTag.value, id });
    const wasEditing = editingId;
    if (wasEditing) list[list.findIndex(p => p.id === wasEditing)] = item;
    else list.push(item);

    editor.close();
    persist();
    search.value = "";
    render();
    flash(id);
    toast(wasEditing ? `“${label(item)}” atualizada` : `“${label(item)}” adicionada`);
  });

  // colar um link de playlist em qualquer lugar da página abre a janela já preenchida
  document.addEventListener("paste", e => {
    if (editor.open) return;
    const text = (e.clipboardData && e.clipboardData.getData("text")) || "";
    if (!parseId(text)) return;
    e.preventDefault();
    openEditor(null, text.trim());
  });

  addBtn.addEventListener("click", () => openEditor(null));

  editBtn.addEventListener("click", () => {
    const on = document.body.classList.toggle("editing");
    editBtn.textContent = on ? "Concluir" : "Editar lista";
    editBtn.setAttribute("aria-pressed", String(on));
  });

  listEl.addEventListener("click", e => {
    const btn = e.target.closest("button[data-act]");
    if (!btn) return;
    const id = btn.closest(".playlist-row").dataset.id;
    const p = list.find(x => x.id === id);
    if (!p) return;
    if (btn.dataset.act === "edit") {
      openEditor(p);
    } else if (confirm(`Remover “${label(p)}” da lista?`)) {
      list = list.filter(x => x.id !== id);
      persist();
      render();
      toast(`“${label(p)}” removida`);
    }
  });

  search.addEventListener("input", applyFilter);

  // ---- salvar: gera o .htm completo com a lista nova dentro
  function fileName() {
    try {
      const n = decodeURIComponent(location.pathname.split("/").pop() || "");
      if (/\.html?$/i.test(n)) return n;
    } catch (e) {}
    return "Playlists do Spotify.htm";
  }

  function serialize() {
    const rows = [...list].sort(cmp).map(p => "  " + JSON.stringify(clean(p)).replace(/</g, "\\u003c"));
    return "\n[\n" + rows.join(",\n") + "\n]\n";
  }

  function buildHTML() {
    const root = document.documentElement.cloneNode(true);
    const head = root.querySelector("head");
    const body = root.querySelector("body");

    // tira qualquer coisa que extensão do navegador tenha injetado na página
    for (const a of [...root.attributes]) root.removeAttribute(a.name);
    root.setAttribute("lang", "pt-BR");
    for (const el of [...root.children]) if (el !== head && el !== body) el.remove();
    for (const el of [...head.children]) if (!el.matches("meta, title, style#app-style")) el.remove();
    for (const el of [...body.children]) if (!el.matches("header, main, dialog#editor, #toast, script#dados, script#app")) el.remove();
    for (const a of [...body.attributes]) body.removeAttribute(a.name);

    root.querySelector("#playlist-list").innerHTML = "";
    root.querySelector("#alphabet").innerHTML = "";
    root.querySelector("#empty").removeAttribute("style");
    root.querySelector("#editor").removeAttribute("open");
    root.querySelector("#f-ok").removeAttribute("disabled");
    root.querySelector("#f-msg").textContent = "";
    root.querySelector("#f-msg").className = "form-msg";
    root.querySelector("#toast").className = "toast";
    root.querySelector("#toast").textContent = "";
    root.querySelector("#save-btn").setAttribute("hidden", "");
    root.querySelector("#save-btn").textContent = "Salvar arquivo";
    root.querySelector("#save-btn").removeAttribute("title");
    root.querySelector("#edit-btn").textContent = "Editar lista";
    root.querySelector("#edit-btn").setAttribute("aria-pressed", "false");
    root.querySelector("#dados").textContent = serialize();

    return "<!DOCTYPE html>\n" + root.outerHTML + "\n";
  }

  function markSaved(msg, ms) {
    reference = list.map(p => ({ ...p }));
    updateSave();
    toast(msg, ms);
  }

  saveBtn.addEventListener("click", async () => {
    const text = buildHTML();
    const name = fileName();

    // Chrome / Edge: grava direto por cima do arquivo escolhido
    if (window.showSaveFilePicker) {
      try {
        if (!fileHandle) {
          fileHandle = await window.showSaveFilePicker({
            suggestedName: name,
            types: [{ description: "Página HTML", accept: { "text/html": [".htm", ".html"] } }]
          });
        }
        const w = await fileHandle.createWritable();
        await w.write(text);
        await w.close();
        markSaved("Arquivo salvo");
        return;
      } catch (err) {
        if (err && err.name === "AbortError") return;
        fileHandle = null;
      }
    }

    // Firefox e outros: baixa o arquivo atualizado
    const url = URL.createObjectURL(new Blob([text], { type: "text/html;charset=utf-8" }));
    const a = document.createElement("a");
    a.href = url;
    a.download = name;
    document.body.append(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 5000);
    markSaved("Arquivo baixado. Troque o antigo por ele.", 4500);
  });

  render();
})();
</script>


</body></html>
